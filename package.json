{
  "name": "centre-court",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:browser": "playwright test",
    "check": "npm test && npm run build && npm run test:browser",
    "format": "prettier --write src tests *.ts index.html docs README.md .github"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "playcanvas": "^2.20.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^3.2.4"
  }
}
